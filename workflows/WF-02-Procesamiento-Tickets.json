    {
      "parameters": {
        "sendTo": "sergram2242@gmail.com",
        "subject": "Nuevo ticket",
        "message": "=<!DOCTYPE html>\n<html>\n<body style=\"font-family: Arial, sans-serif;\">\n\n<div style=\"max-width:700px;margin:auto;border:1px solid #ddd;border-radius:10px;padding:20px;\">\n\n  <h2 style=\"color:#dc2626;\">\n    Nuevo Ticket Registrado\n  </h2>\n\n  <table style=\"width:100%;border-collapse:collapse;\">\n\n    <tr>\n      <td><strong>Código:</strong></td>\n      <td>{{ $json.ticket_codigo }}</td>\n    </tr>\n\n    <tr>\n      <td><strong>Usuario:</strong></td>\n      <td>{{ $json.body.nombre }}</td>\n    </tr>\n\n    <tr>\n      <td><strong>Correo:</strong></td>\n      <td>{{ $json.body.correo }}</td>\n    </tr>\n\n    <tr>\n      <td><strong>Categoría:</strong></td>\n      <td>{{ $json.body.categoria}}</td>\n    </tr>\n\n    <tr>\n      <td><strong>Prioridad:</strong></td>\n      <td>\n        <strong style=\"color:red;\">\n          {{ $json.prioridad }}\n        </strong>\n      </td>\n    </tr>\n\n  </table>\n\n  <br>\n\n  <h3>Descripción del problema</h3>\n\n  <div style=\"\n      background:#f8fafc;\n      border-left:4px solid #2563eb;\n      padding:15px;\n      border-radius:5px;\n  \">\n    {{ $json.body.asunto }}\n  </div>\n\n  <br>\n\n  <p>\n    Favor dar seguimiento según la prioridad asignada.\n  </p>\n\n  <hr>\n\n  <p style=\"font-size:12px;color:gray;\">\n    Sistema Mesa de Ayuda - Notificación Automática\n  </p>\n\n</div>\n\n</body>\n</html>",
        "options": {}
      },
