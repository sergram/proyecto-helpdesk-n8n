        "message": "=<!DOCTYPE html>\n<html>\n<body style=\"font-family: Arial, sans-serif;\">\n\n  <div style=\"max-width:600px;margin:auto;border:1px solid #ddd;border-radius:10px;padding:20px;\">\n\n    <h2 style=\"color:#2563eb;\">\n      Ticket recibido correctamente\n    </h2>\n\n    <p>\n      Estimado/a <strong>{{ $json.body.nombre }}</strong>,\n    </p>\n\n    <p>\n      Su solicitud ha sido registrada exitosamente en la Mesa de Ayuda.\n    </p>\n\n    <table style=\"width:100%;border-collapse:collapse;\">\n      <tr>\n        <td><strong>Código:</strong></td>\n        <td>{{ $json.ticket_codigo }}</td>\n      </tr>\n\n      <tr>\n        <td><strong>Categoría:</strong></td>\n        <td>{{ $json.body.categoria }}</td>\n      </tr>\n\n      <tr>\n        <td><strong>Prioridad:</strong></td>\n        <td>{{ $json.prioridad }}</td>\n      </tr>\n\n    </table>\n\n    <br>\n\n    <p>\n      Nuestro equipo revisará su solicitud a la brevedad.\n    </p>\n\n    <hr>\n\n    <p style=\"font-size:12px;color:gray;\">\n      Mesa de Ayuda Automatizada - Proyecto Análisis de Sistemas I\n    </p>\n\n  </div>\n\n</body>\n</html>",
