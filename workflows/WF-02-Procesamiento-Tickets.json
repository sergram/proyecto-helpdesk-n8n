    {
      "parameters": {
        "jsCode": "const categoria = ($('seleccionar datos').first().json.body.categoria)\n  .trim()\n  .toLowerCase();\n\nlet prioridad = \"BAJA\";\n\nswitch (categoria) {\n\n  case \"red\":\n  case \"base de datos\":\n    prioridad = \"ALTA\";\n    break;\n\n  case \"hardware\":\n  case \"correo\":\n    prioridad = \"MEDIA\";\n    break;\n\n  case \"software\":\n  case \"otros\":\n  default:\n    prioridad = \"BAJA\";\n}\n\nreturn [{\n  json: {\n    ...$json,\n    prioridad,\n    categoria_normalizada: categoria\n  }\n}];"
      },
